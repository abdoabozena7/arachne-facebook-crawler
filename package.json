{
  "name": "arachne-local-crawler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A visible, event-driven Facebook crawler with a living Canvas network and auditable evidence.",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs && tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:headed": "npm run build && tsx scripts/validate-headed.ts",
    "install:browser": "playwright install chromium"
  },
  "dependencies": { "playwright": "^1.56.0" },
  "devDependencies": { "@types/node": "^22.18.0", "esbuild": "^0.25.10", "tsx": "^4.20.0", "typescript": "^5.9.0" }
}
